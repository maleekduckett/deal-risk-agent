    {
      "parameters": {
        "promptType": "define",
        "text": "=Synthesize an overall deal risk assessment for {{ $json.company_name }} (deal {{ $json.deal_id }}) from the three specialist findings below.\n\nEngagement risk: {{ $json.engagement_output.engagement_risk_level }} (confidence {{ $json.engagement_output.confidence }}) - {{ $json.engagement_output.reasoning }}\n\nICP fit: {{ $json.icp_output.icp_fit_level }} (confidence {{ $json.icp_output.confidence }}) - {{ $json.icp_output.reasoning }}\n\nCompetitive risk: {{ $json.competitive_output.competitive_risk_level }} (confidence {{ $json.competitive_output.confidence }}) - {{ $json.competitive_output.reasoning }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are the synthesis agent in a multi-agent sales deal-risk assessment system. Combine the three specialist findings (engagement pattern, ICP fit, competitive risk) into one overall risk assessment. Weigh engagement pattern most heavily, then ICP fit, then competitive risk. Return only the structured output: overall_risk_level (Low, Medium, or High), overall_confidence, a recommended_action (one sentence - what the rep should do next), and a one-to-two sentence reasoning that references the specific driving signals."
        }
      },
